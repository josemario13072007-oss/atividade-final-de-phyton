def exibir_cardapio():
    print("========= CARDÁPIO =========================")
    print("Código 101 - Hambúrguer Simples - R$ 15.00")
    print("Código 102 - Cheeseburger      - R$ 18.00")
    print("Código 103 - Batata Frita      - R$ 12.00")
    print("Código 104 - Refrigerante      - R$  7.00")
    print("Código 105 - Suco Natural      - R$  8.50")
    print("Código 106 - Onion Rings         - R$ 10.00")
    print("=============================================")

def obter_preco(codigo):
    match codigo:
        case 101:
            return 15.00
        case 102:
            return 18.00
        case 103:
            return 12.00
        case 104:
            return 7.00
        case 105:
            return 8.50
        case 106:
            return 10.0
        

def calcular_desconto(total):
    if total < 50.00:
        return 0, 0.0
    elif total < 100.00:
        return 5, total * 0.05
    else:
        return 10, total * 0.10

def obter_forma_pagamento():
    while True:
        print("Formas de Pagamento:")
        print("1. Dinheiro")
        print("2. PIX")
        print("3. Cartão")
        opcao = input("Escolha a forma de pagamento (1-3): ")
        
        match opcao:
            case "1":
                return "Dinheiro"
            case "2":
                return "PIX"
            case "3":
                return "Cartão"
            case _:
                print("Opção inválida. Tente novamente.")

def exibir_resumo(nome, total_original, porc_desc, valor_desc, total_final, forma_pagto):
    print("=========================================")
    print("           RESUMO DO PEDIDO              ")
    print("=========================================")
    print(f"Cliente: {nome}")
    print(f"Valor Original: R$ {total_original:.2f}")
    print(f"Desconto Aplicado: {porc_desc}%")
    print(f"Valor do Desconto: R$ {valor_desc:.2f}")
    print(f"Valor Final: R$ {total_final:.2f}")
    print(f"Forma de Pagamento: {forma_pagto}")
    print("=========================================")

def sistema_atendimento():

    nome_cliente = input("Por favor, digite o seu nome: ")
        
    total_compra = 0.0
    continuar = "s"
    
    while continuar.lower() == "s":
        exibir_cardapio()
        
        codigo_input = input("Digite o código do produto desejado: ")
        if not codigo_input.isdigit():
            print("Código inválido! Digite apenas números.")
            continue
            
        codigo = int(codigo_input)
        preco = obter_preco(codigo)
        
        if preco == -1.0:
            print("Código do produto inexistente. Tente novamente.")
            continue
            
        qtd_input = input("Digite a quantidade desejada: ")
        if not qtd_input.isdigit():
            print("Quantidade inválida! Digite apenas números.")
            continue
            
        quantidade = int(qtd_input)
        if quantidade <= 0:
            print("A quantidade deve ser maior que zero.")
            continue
            
        subtotal = preco * quantidade
        total_compra += subtotal
        print(f"Subtotal: R$ {subtotal:.2f} adicionado ao pedido.")
        
        continuar = input("Deseja adicionar mais algum produto? (S/N): ")
        while continuar.lower() not in ["s", "n"]:
            continuar = input("Opção inválida. Digite S para Sim ou N para Não: ")

    if total_compra == 0:
        print("Nenhum produto foi adicionado. Atendimento encerrado.")
        return

    porc_desc, valor_desc = calcular_desconto(total_compra)
    total_final = total_compra - valor_desc
    
    print(f"Total atual da compra: R$ {total_compra:.2f}")
    forma_pagto = obter_forma_pagamento()
    
    exibir_resumo(nome_cliente, total_compra, porc_desc, valor_desc, total_final, forma_pagto)

sistema_atendimento()
